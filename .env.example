# ==============================================
# TRADING SYSTEM — KONFIGURACJA
# Skopiuj do .env i uzupełnij wartości
# cp .env.example .env
# ==============================================

# === TRYB TRADINGU ===
# "paper" — symulacja (domyślnie, bezpieczne)
# "live"  — prawdziwe transakcje na Lighter DEX
TRADING_MODE=paper

# === LLM APIs ===

# Groq — szybkie LLM (weryfikacja setupów co 5 min, zawsze)
# Rejestracja: https://console.groq.com — darmowy tier
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenRouter — DeepSeek R1 (wszystkie głębokie operacje LLM)
# Rejestracja: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini — Knowledge Base Importer (analiza PDF strategii)
# Rejestracja: https://aistudio.google.com/apikey — darmowy tier
GEMINI_API_KEY=

# === LIGHTER DEX ===
# Uzupełnij tylko przy przejściu na TRADING_MODE=live
LIGHTER_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_NETWORK=mainnet

# === TELEGRAM ===
# Bot token: @BotFather na Telegram → /newbot
TELEGRAM_BOT_TOKEN=
# Twoje chat ID: @userinfobot na Telegram
TELEGRAM_CHAT_ID=

# === DASHBOARD ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET=zmien_mnie_na_losowy_string

# === BAZA DANYCH ===
DATABASE_PATH=./database/trading.db
CHROMADB_PATH=./database/chromadb

# === SYSTEM ===
LOG_LEVEL=INFO
TIMEZONE=Europe/Warsaw
MIN_VOLUME_USD=1000000
